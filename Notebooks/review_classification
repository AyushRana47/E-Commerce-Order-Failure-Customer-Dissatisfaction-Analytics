      "source": [
        "import pandas as pd\n",
        "import os\n",
        "\n",
        "# ============================================================\n",
        "# 1. LOAD YOUR CLASSIFIED EXCEL FILE\n",
        "# ============================================================\n",
        "\n",
        "CLASSIFIED_FILE = \"classified.xlsx\"\n",
        "\n",
        "if not os.path.exists(CLASSIFIED_FILE):\n",
        "    raise FileNotFoundError(\n",
        "        f\"Could not find {CLASSIFIED_FILE}. \"\n",
        "        \"Make sure the file has been uploaded to Colab.\"\n",
        "    )\n",
        "\n",
        "classified_reviews = pd.read_excel(CLASSIFIED_FILE)\n",
        "\n",
        "print(f\"Loaded file: {CLASSIFIED_FILE}\")\n",
        "print(f\"Rows: {len(classified_reviews):,}\")\n",
        "print(f\"Columns: {classified_reviews.columns.tolist()}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. REQUIRED COLUMNS\n",
        "# ============================================================\n",
        "\n",
        "REQUIRED_COLUMNS = [\n",
        "    \"review_id\",\n",
        "    \"order_id\",\n",
        "    \"primary_cause\"\n",
        "]\n",
        "\n",
        "missing_columns = [\n",
        "    col for col in REQUIRED_COLUMNS\n",
        "    if col not in classified_reviews.columns\n",
        "]\n",
        "\n",
        "if missing_columns:\n",
        "    raise ValueError(\n",
        "        f\"Missing required column(s): {missing_columns}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. REBUILD REVIEW TEXT\n",
        "# ============================================================\n",
        "\n",
        "def has_text(value):\n",
        "    return isinstance(value, str) and value.strip() != \"\"\n",
        "\n",
        "\n",
        "def build_review_text(row):\n",
        "    title = row.get(\"review_comment_title\")\n",
        "    message = row.get(\"review_comment_message\")\n",
        "\n",
        "    parts = []\n",
        "\n",
        "    if has_text(title):\n",
        "        parts.append(str(title).strip())\n",
        "\n",
        "    if has_text(message):\n",
        "        parts.append(str(message).strip())\n",
        "\n",
        "    return \" - \".join(parts)\n",
        "\n",
        "\n",
        "classified_reviews[\"review_text\"] = (\n",
        "    classified_reviews.apply(build_review_text, axis=1)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. CURRENT TAXONOMY\n",
        "# ============================================================\n",
        "\n",
        "TAXONOMY = [\n",
        "    \"LATE_DELIVERY\",\n",
        "    \"PRODUCT_QUALITY\",\n",
        "    \"PRODUCT_NOT_AS_DESCRIBED\",\n",
        "    \"WRONG_PRODUCT\",\n",
        "    \"MISSING_ITEM\",\n",
        "    \"SIZE_OR_FIT\",\n",
        "    \"DAMAGED_PRODUCT\",\n",
        "    \"DAMAGED_PACKAGING\",\n",
        "    \"SELLER_SERVICE\",\n",
        "    \"PAYMENT_ISSUE\",\n",
        "    \"DELIVERY_HANDLING\",\n",
        "    \"OTHER\",\n",
        "    \"NO_CLEAR_ISSUE\",\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. VALIDATE PRIMARY CAUSE\n",
        "# ============================================================\n",
        "\n",
        "classified_reviews[\"primary_cause\"] = (\n",
        "    classified_reviews[\"primary_cause\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "invalid_primary = classified_reviews[\n",
        "    ~classified_reviews[\"primary_cause\"].isin(TAXONOMY)\n",
        "]\n",
        "\n",
        "if len(invalid_primary) > 0:\n",
        "\n",
        "    print(\n",
        "        f\"\\nWARNING: {len(invalid_primary)} rows contain \"\n",
        "        \"an invalid primary_cause:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        invalid_primary[\"primary_cause\"]\n",
        "        .value_counts()\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\n",
        "        \"\\nAll primary_cause values match the current taxonomy.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. CHECK MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nMissing values:\")\n",
        "\n",
        "print(\n",
        "    classified_reviews[\n",
        "        [\"order_id\", \"review_id\", \"primary_cause\", \"review_text\"]\n",
        "    ]\n",
        "    .isna()\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. CHECK DUPLICATE REVIEW IDS\n",
        "# ============================================================\n",
        "\n",
        "duplicate_reviews = classified_reviews[\n",
        "    classified_reviews.duplicated(\n",
        "        subset=[\"review_id\"],\n",
        "        keep=False\n",
        "    )\n",
        "]\n",
        "\n",
        "if len(duplicate_reviews) > 0:\n",
        "\n",
        "    print(\n",
        "        f\"\\nNOTE: {len(duplicate_reviews):,} rows share \"\n",
        "        f\"{duplicate_reviews['review_id'].nunique():,} \"\n",
        "        \"duplicate review_id values.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\"\\nNo duplicate review_id values found.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. ROOT-CAUSE DISTRIBUTION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nPrimary Cause Distribution:\")\n",
        "\n",
        "cause_distribution = (\n",
        "    classified_reviews[\"primary_cause\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"primary_cause\")\n",
        "    .reset_index(name=\"review_count\")\n",
        ")\n",
        "\n",
        "cause_distribution[\"percentage\"] = (\n",
        "    cause_distribution[\"review_count\"]\n",
        "    / len(classified_reviews)\n",
        "    * 100\n",
        ").round(2)\n",
        "\n",
        "display(cause_distribution)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. SAVE CLEAN CLASSIFIED FILE\n",
        "# ============================================================\n",
        "\n",
        "FINAL_FILE = \"classified_reviews_clean.csv\"\n",
        "\n",
        "classified_reviews.to_csv(\n",
        "    FINAL_FILE,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nSaved cleaned classified dataset:\"\n",
        "    f\"\\n{FINAL_FILE}\"\n",
        "    f\"\\nRows: {len(classified_reviews):,}\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. PREVIEW\n",
        "# ============================================================\n",
        "\n",
        "display(\n",
        "    classified_reviews[\n",
        "        [\n",
        "            \"order_id\",\n",
        "            \"review_id\",\n",
        "            \"review_score\",\n",
        "            \"review_text\",\n",
        "            \"primary_cause\"\n",
        "        ]\n",
        "    ].head(10)\n",
        ")"
