      "source": [
        "### 09. Classification Function\n",
        "\n",
        "Defined here (ahead of Section 08's smoke test, which needs it) so the notebook is\n",
        "runnable top-to-bottom. Handles the actual API call, structured-output parsing,\n",
        "validation of every field against the taxonomy/severity/confidence constraints, and\n",
        "retries with exponential backoff for transient failures.\n"
      ],
      "id": "dOOcBCLwv7J4"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "nNixjw7uv7J4",
        "outputId": "15d7ecc3-51d7-4ab3-d14b-d5d9b7eeedff"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Classification function configured.\n",
            "Model: gemini-3.6-flash\n"
          ]
        }
      ],
      "source": [
        "import json\n",
        "import time\n",
        "from google.genai import types\n",
        "\n",
        "\n",
        "class ClassificationError(Exception):\n",
        "    \"\"\"Raised when a response cannot be turned into a valid classification\n",
        "    after all retries are exhausted.\"\"\"\n",
        "    pass\n",
        "\n",
        "\n",
        "def _validate_classification(data: dict) -> dict:\n",
        "    if data.get(\"primary_cause\") not in TAXONOMY:\n",
        "        raise ValueError(\n",
        "            f\"Invalid primary_cause: {data.get('primary_cause')!r}\"\n",
        "        )\n",
        "\n",
        "    secondary = data.get(\"secondary_cause\")\n",
        "\n",
        "    if secondary is not None and secondary not in TAXONOMY:\n",
        "        raise ValueError(\n",
        "            f\"Invalid secondary_cause: {secondary!r}\"\n",
        "        )\n",
        "\n",
        "    if data.get(\"severity\") not in SEVERITY_LEVELS:\n",
        "        raise ValueError(\n",
        "            f\"Invalid severity: {data.get('severity')!r}\"\n",
        "        )\n",
        "\n",
        "    confidence = data.get(\"confidence\")\n",
        "\n",
        "    if not isinstance(confidence, (int, float)) or not (0 <= confidence <= 1):\n",
        "        raise ValueError(\n",
        "            f\"Invalid confidence: {confidence!r}\"\n",
        "        )\n",
        "\n",
        "    if not isinstance(data.get(\"evidence\"), str):\n",
        "        raise ValueError(\"evidence must be a string\")\n",
        "\n",
        "    return {\n",
        "        \"primary_cause\": data[\"primary_cause\"],\n",
        "        \"secondary_cause\": secondary,\n",
        "        \"severity\": data[\"severity\"],\n",
        "        \"confidence\": float(confidence),\n",
        "        \"evidence\": data[\"evidence\"].strip(),\n",
        "    }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# GEMINI CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "MODEL_NAME = \"gemini-3.6-flash\"\n",
        "\n",
        "_generation_config = types.GenerateContentConfig(\n",
        "    system_instruction=SYSTEM_PROMPT,\n",
        "    response_mime_type=\"application/json\",\n",
        "    response_schema=RESPONSE_JSON_SCHEMA,\n",
        "    temperature=0,\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SINGLE LLM CALL\n",
        "# ============================================================\n",
        "\n",
        "def call_llm(review_text: str) -> dict:\n",
        "    \"\"\"\n",
        "    Send one review to Gemini and return a validated classification.\n",
        "    \"\"\"\n",
        "\n",
        "    response = client.models.generate_content(\n",
        "        model=MODEL_NAME,\n",
        "        contents=f\"Review text:\\n{review_text}\",\n",
        "        config=_generation_config,\n",
        "    )\n",
        "\n",
        "    raw_content = response.text\n",
        "\n",
        "    if not raw_content:\n",
        "        raise ValueError(\"Gemini returned an empty response.\")\n",
        "\n",
        "    try:\n",
        "        data = json.loads(raw_content)\n",
        "\n",
        "    except json.JSONDecodeError as e:\n",
        "        raise ValueError(\n",
        "            f\"Malformed JSON from model: {e}\\n\"\n",
        "            f\"Raw response: {raw_content!r}\"\n",
        "        )\n",
        "\n",
        "    # Missing secondary cause means no secondary cause\n",
        "    data.setdefault(\"secondary_cause\", None)\n",
        "\n",
        "    return _validate_classification(data)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CLASSIFY ONE REVIEW WITH RETRIES\n",
        "# ============================================================\n",
        "\n",
        "def classify_review(review_text: str) -> dict:\n",
        "    \"\"\"\n",
        "    Classify one review.\n",
        "\n",
        "    Returns:\n",
        "        primary_cause\n",
        "        secondary_cause\n",
        "        severity\n",
        "        confidence\n",
        "        evidence\n",
        "        status\n",
        "        error_message\n",
        "    \"\"\"\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Empty review\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if not isinstance(review_text, str) or review_text.strip() == \"\":\n",
        "        return {\n",
        "            \"primary_cause\": \"NO_CLEAR_ISSUE\",\n",
        "            \"secondary_cause\": None,\n",
        "            \"severity\": \"LOW\",\n",
        "            \"confidence\": 1.0,\n",
        "            \"evidence\": \"No review text was provided.\",\n",
        "            \"status\": \"empty_text\",\n",
        "            \"error_message\": None,\n",
        "        }\n",
        "\n",
        "    last_error = None\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Retry loop\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    for attempt in range(1, MAX_RETRIES + 1):\n",
        "\n",
        "        try:\n",
        "\n",
        "            result = call_llm(review_text)\n",
        "\n",
        "            result[\"status\"] = \"ok\"\n",
        "            result[\"error_message\"] = None\n",
        "\n",
        "            return result\n",
        "\n",
        "        except Exception as e:\n",
        "\n",
        "            last_error = e\n",
        "\n",
        "            # Print the actual API error so we can diagnose\n",
        "            # rate limits, quota errors, malformed requests, etc.\n",
        "            print(\n",
        "                f\"Attempt {attempt}/{MAX_RETRIES} failed: \"\n",
        "                f\"{type(e).__name__}: {e}\"\n",
        "            )\n",
        "\n",
        "            # Stop after final attempt\n",
        "            if attempt == MAX_RETRIES:\n",
        "                break\n",
        "\n",
        "            # Exponential backoff:\n",
        "            # attempt 1 → 2 seconds\n",
        "            # attempt 2 → 4 seconds\n",
        "            # attempt 3 → 8 seconds\n",
        "            # attempt 4 → 16 seconds\n",
        "            # capped at 60 seconds\n",
        "            backoff = min(60, 2 ** attempt)\n",
        "\n",
        "            print(\n",
        "                f\"Waiting {backoff} seconds before retry...\"\n",
        "            )\n",
        "\n",
        "            time.sleep(backoff)\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # All retries failed\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    return {\n",
        "        \"primary_cause\": None,\n",
        "        \"secondary_cause\": None,\n",
        "        \"severity\": None,\n",
        "        \"confidence\": None,\n",
        "        \"evidence\": None,\n",
        "        \"status\": \"error\",\n",
        "        \"error_message\": str(last_error),\n",
        "    }\n",
        "\n",
        "\n",
        "print(\"Classification function configured.\")\n",
        "print(\"Model:\", MODEL_NAME)"
