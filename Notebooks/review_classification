        "# Gemini's structured-output schema is a restricted OpenAPI-3.0-style subset:\n",
        "# no `anyOf`, no `additionalProperties`, no `minimum`/`maximum` on numbers.\n",
        "# Nullability is expressed with `\"nullable\": True` instead. Numeric bounds on\n",
        "# confidence are enforced in code (_validate_classification below), not by\n",
        "# the schema itself.\n",
        "RESPONSE_JSON_SCHEMA = {\n",
        "    \"type\": \"object\",\n",
        "    \"properties\": {\n",
        "        \"primary_cause\": {\"type\": \"string\", \"enum\": TAXONOMY},\n",
        "        \"secondary_cause\": {\"type\": \"string\", \"enum\": TAXONOMY, \"nullable\": True},\n",
        "        \"severity\": {\"type\": \"string\", \"enum\": SEVERITY_LEVELS},\n",
        "        \"confidence\": {\"type\": \"number\"},\n",
        "        \"evidence\": {\"type\": \"string\"},\n",
        "    },\n",
        "    \"required\": [\"primary_cause\", \"severity\", \"confidence\", \"evidence\"],\n",
        "}\n"
      ],
